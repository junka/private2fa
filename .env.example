# ==================== 数据库（PostgreSQL） ====================
# Prisma 使用的连接串（连接池/代理）
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/dbname"

# 迁移/直连使用的连接串（务必为非连接池形式，否则迁移可能产生挂起的数据库）
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/dbname"

# ==================== NextAuth ====================
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-bytes-string"

# 部署环境需显式指定；本地开发可省略（默认 http://localhost:3000）
NEXTAUTH_URL="http://localhost:3000"

# ==================== GitHub OAuth ====================
# 在 https://github.com/settings/developers 创建 OAuth App 后填写
# 回调地址: http://localhost:3000/api/auth/callback/github
GITHUB_ID="REDACTED_GITHUB_ID"
GITHUB_SECRET="REDACTED_GITHUB_SECRET"

# ==================== Google OAuth ====================
# 在 https://console.cloud.google.com/apis/credentials 创建凭据后填写
# 回调地址: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="REDACTED_GOOGLE_ID"
GOOGLE_CLIENT_SECRET="REDACTED_GOOGLE_SECRET"